{
  "name": "elite-setup-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node index.js",
    "dev:frontend": "prisma generate && next dev --turbo",
    "dev:backend": "npm --prefix server start",
    "build": "prisma generate && cross-env NODE_ENV=production next build",
    "start": "next start",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js --update-env",
    "pm2:reload": "pm2 reload ecosystem.config.js --update-env",
    "pm2:logs": "pm2 logs",
    "deploy:server": "bash scripts/deploy.sh",
    "images:convert-public": "node scripts/convert-public-images-to-webp.js",
    "lint": "next lint",
    "db:generate": "prisma generate && npm --prefix server run db:generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:gaming": "node server/scripts/seed-gaming-store.js"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@prisma/client": "^6.16.1",
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/react-slick": "^0.23.13",
    "axios": "^1.12.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.0.8",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "express-fileupload": "^1.5.0",
    "express-rate-limit": "^8.1.0",
    "flowbite-react": "^0.7.2",
    "form-data": "^4.0.4",
    "morgan": "^1.10.1",
    "mysql": "^2.18.1",
    "nanoid": "^5.0.6",
    "next": "^16.2.6",
    "next-auth": "^4.24.11",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-apexcharts": "^1.4.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.0.1",
    "react-slick": "^0.30.2",
    "sharp": "^0.34.5",
    "slick-carousel": "^1.8.1",
    "svgmap": "^2.10.1",
    "winston": "^3.8.2",
    "zod": "^3.22.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.3.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "daisyui": "^4.7.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.3",
    "postcss": "^8",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.9.2"
  }
}
